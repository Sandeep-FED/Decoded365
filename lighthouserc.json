{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/index.html", "/browse/index.html", "/terms/hub-site/index.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
