---
import { AVAILABLE_PRODUCTS, PRODUCT_GRAPH_COLOURS, PRODUCT_LABELS } from '@/lib/glossary/labels';
import { PRODUCTS } from '@/schema/term';

const products = PRODUCTS.filter((p) => AVAILABLE_PRODUCTS.includes(p));
---

<ul aria-label="Map legend" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
	{
		products.map((p) => (
			<li class="flex items-center gap-2">
				<span aria-hidden="true" class="size-3 rounded-full" style={`background:${PRODUCT_GRAPH_COLOURS[p]}`} />
				{PRODUCT_LABELS[p]}
			</li>
		))
	}
	<li class="flex items-center gap-2">
		<span aria-hidden="true" class="size-3 rounded-full border-2 border-dashed border-foreground/70" />
		Legacy or retired
	</li>
	<li class="flex items-center gap-2">
		<span aria-hidden="true" class="inline-block h-0 w-6 border-t-2 border-dashed border-foreground/50" />
		Two-way relation
	</li>
	<li>Bigger dot = more connections</li>
</ul>
