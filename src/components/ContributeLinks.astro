---
import { SITE } from '@/config/site';
import { editTermUrl, reportErrorUrl } from '@/lib/contribute/issue-links';
import type { GlossaryTerm } from '@/lib/glossary/term-model';

interface Props {
	term: GlossaryTerm;
}
const { term } = Astro.props;
---

<p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
	<a class="underline underline-offset-4" href={editTermUrl(SITE.repoUrl, term.product, term.id)}>Edit this term</a>
	<a class="underline underline-offset-4" href={reportErrorUrl(SITE.repoUrl, term.term, term.id)}>Report an error</a>
</p>
