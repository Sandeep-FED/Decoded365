---
interface Props {
	items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
	<ol class="flex flex-wrap items-center gap-1.5">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-1.5">
					{index > 0 && <span aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href} class="hover:text-foreground hover:underline">{item.label}</a>
					) : (
						<span aria-current={index === items.length - 1 ? 'page' : undefined} class={index === items.length - 1 ? 'text-foreground' : undefined}>{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
