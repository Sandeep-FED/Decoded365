---
import { SITE } from '@/config/site';
import { suggestTermUrl } from '@/lib/contribute/issue-links';
import { downloadsPath, feedPath } from '@/lib/paths';
---

<footer class="border-t text-sm text-muted-foreground">
	<div class="mx-auto max-w-5xl space-y-2 px-4 py-6 sm:px-6">
		<p>{SITE.disclaimer}</p>
		<p>
			Code is {SITE.codeLicence}; content is {SITE.contentLicence}. No accounts, cookies or tracking.
		</p>
		<p class="flex flex-wrap gap-x-4">
			<a class="underline underline-offset-4" href={suggestTermUrl(SITE.repoUrl)}>Suggest a term</a>
			<a class="underline underline-offset-4" href={downloadsPath()}>Downloads</a>
			<a class="underline underline-offset-4" href={feedPath()}>Atom feed</a>
			<a class="underline underline-offset-4" href={SITE.repoUrl}>Source on GitHub</a>
		</p>
	</div>
</footer>
