---
import NavLinks from '@/components/NavLinks.astro';
import SearchCommand from '@/components/islands/SearchCommand';
import { SITE } from '@/config/site';
import { withBase } from '@/lib/paths';

const pill = 'rounded-full border bg-background/70 shadow-lg backdrop-blur-md';
---

<header class="sticky top-3 z-40 px-3 pt-3">
	<div class:list={['mx-auto flex max-w-3xl items-center gap-2 py-1.5 pl-4 pr-1.5', pill]}>
		<a href={withBase('/')} class="font-heading font-semibold tracking-tight">
			{SITE.name}
		</a>
		<nav aria-label="Main" class="ml-auto hidden items-center gap-1 sm:flex">
			<NavLinks />
		</nav>
		<div class="ml-auto flex items-center gap-1 sm:ml-2">
			<SearchCommand client:load />
		</div>
	</div>
	<nav aria-label="Main" class:list={['mx-auto mt-2 flex w-fit items-center gap-1 p-1 sm:hidden', pill]}>
		<NavLinks />
	</nav>
</header>
