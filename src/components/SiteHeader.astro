---
import SearchCommand from '@/components/islands/SearchCommand';
import ThemeToggle from '@/components/islands/ThemeToggle';
import { SITE } from '@/config/site';
import { browsePath, creditsPath, mapPath, withBase } from '@/lib/paths';

const links = [
	{ href: browsePath(), label: 'Browse A–Z' },
	{ href: mapPath(), label: 'Map' },
	{ href: creditsPath(), label: 'Credits' },
];
---

<header class="border-b">
	<div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
		<a href={withBase('/')} class="font-heading text-lg font-semibold tracking-tight">{SITE.name}</a>
		<nav aria-label="Main" class="flex flex-1 flex-wrap items-center gap-x-4 gap-y-1 text-sm">
			{links.map((link) => <a href={link.href} class="text-muted-foreground hover:text-foreground">{link.label}</a>)}
		</nav>
		<div class="flex items-center gap-2">
			<SearchCommand client:load />
			<ThemeToggle client:load />
		</div>
	</div>
</header>
