---
import { browsePath } from '@/lib/paths';

const links = [
	{ href: browsePath(), label: 'Browse A–Z' },
];
const current = Astro.url.pathname;
---

{
	links.map((link) => (
		<a
			href={link.href}
			aria-current={current.startsWith(link.href) ? 'page' : undefined}
			class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
		>
			{link.label}
		</a>
	))
}
