---
import { browsePath, comparePath, newPath, renamedPath } from '@/lib/paths';

const links = [
	{ href: browsePath(), label: 'Browse A–Z' },
	{ href: comparePath(), label: 'Compare' },
	{ href: renamedPath(), label: 'Renamed' },
	{ href: newPath(), label: 'What\'s new' },
];
const current = Astro.url.pathname;
---

{
	links.map((link) => (
		<a
			href={link.href}
			aria-current={current.startsWith(link.href) ? 'page' : undefined}
			class="whitespace-nowrap rounded-full px-2 py-1.5 text-sm text-muted-foreground sm:px-3 transition-colors hover:bg-accent hover:text-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
		>
			{link.label}
		</a>
	))
}
