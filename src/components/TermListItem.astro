---
import ProductBadge from '@/components/ProductBadge.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import type { GlossaryTerm } from '@/lib/glossary/term-model';
import { termPath } from '@/lib/paths';

interface Props {
	term: GlossaryTerm;
}
const { term } = Astro.props;
---

<li data-term-item data-product={term.product} data-legacy-term={term.legacy ? '' : undefined} class="space-y-1 py-3">
	<div class="flex flex-wrap items-center gap-2">
		<a href={termPath(term.id)} class="font-medium underline-offset-4 hover:underline">{term.term}</a>
		<ProductBadge product={term.product} />
		{term.status !== 'ga' && <StatusBadge status={term.status} />}
	</div>
	<p class="text-sm text-muted-foreground">{term.summary}</p>
</li>
