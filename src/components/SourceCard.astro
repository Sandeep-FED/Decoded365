---
import LicenceBadge from '@/components/LicenceBadge.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import type { SourceData } from '@/schema/source';

interface Props {
	source: SourceData;
	/** Number of glossary terms that cite this source. */
	termCount: number;
}
const { source, termCount } = Astro.props;
---

<Card className="h-full bg-card/70 backdrop-blur-sm">
	<CardHeader>
		<CardTitle className="text-base">{source.title}</CardTitle>
		<CardDescription>{source.owner}</CardDescription>
	</CardHeader>
	<CardContent className="space-y-3 text-sm">
		<div class="flex flex-wrap items-center gap-2">
			<LicenceBadge licence={source.licence} />
			<span class="text-muted-foreground">{source.licence}</span>
		</div>
		<p>{source.use}</p>
		{termCount > 0 && <p class="text-xs text-muted-foreground">Cited by {termCount} {termCount === 1 ? 'term' : 'terms'}</p>}
	</CardContent>
</Card>
