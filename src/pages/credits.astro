---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SourceCard from '@/components/SourceCard.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { SITE } from '@/config/site';
import { STACK, USE_EXPLAINED } from '@/config/credits';
import { suggestTermUrl } from '@/lib/contribute/issue-links';
import { countSourceUsage } from '@/lib/credits/source-usage';
import { getGlossary, getSources } from '@/lib/glossary/repository';
import { ORIGIN_USES } from '@/schema/term';
import { cn } from '@/lib/utils';

const [terms, sourceMap] = await Promise.all([getGlossary(), getSources()]);
const sources = [...sourceMap.values()];
const usage = countSourceUsage(terms);

const releases = [
	{ id: 'v1', label: 'Used now', note: 'Version 1: SharePoint' },
	{ id: 'v1.1', label: 'Planned', note: 'Version 1.1: Power Platform' },
	{ id: 'v1.2', label: 'Planned', note: 'Version 1.2: Copilot' },
] as const;
---

<BaseLayout title="Credits & licences" description="Where Decoded365 content comes from and how it is licensed.">
	<div class="space-y-12">
		<PageHeader
			eyebrow="About"
			title="Credits & licences"
			description="Decoded365 gathers terms from existing glossaries and rewrites each one at three levels. Everything here is free and open, and every source is credited in plain text."
		/>

		<section aria-labelledby="licences" class="space-y-4">
			<h2 id="licences" class="text-xl font-semibold">Licences</h2>
			<div class="grid gap-4 sm:grid-cols-2">
				<Card className="bg-card/70 backdrop-blur-sm">
					<CardHeader>
						<CardTitle>Content: {SITE.contentLicence}</CardTitle>
						<CardDescription>Glossary entries</CardDescription>
					</CardHeader>
					<CardContent className="text-sm">Reuse and adapt them, including commercially, as long as you credit Decoded365 and say if you changed them.</CardContent>
				</Card>
				<Card className="bg-card/70 backdrop-blur-sm">
					<CardHeader>
						<CardTitle>Code: {SITE.codeLicence}</CardTitle>
						<CardDescription>The website itself</CardDescription>
					</CardHeader>
					<CardContent className="text-sm">The source is public. Fork it, run it, improve it.</CardContent>
				</Card>
			</div>
			<p class="text-sm text-muted-foreground">{SITE.disclaimer} No accounts, cookies or tracking are used.</p>
		</section>

		<section aria-labelledby="provenance" class="space-y-4">
			<h2 id="provenance" class="text-xl font-semibold">How we use sources</h2>
			<p class="max-w-2xl text-muted-foreground">
				Each entry lists where it came from, as plain text and never as a link. The label tells you how much of a source we used.
			</p>
			<dl class="grid gap-4 sm:grid-cols-3">
				{
					ORIGIN_USES.map((use) => (
						<div class="rounded-xl border bg-card/70 p-4 backdrop-blur-sm">
							<dt class="mb-1 font-medium">{USE_EXPLAINED[use].title}</dt>
							<dd class="text-sm text-muted-foreground">{USE_EXPLAINED[use].text}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section aria-labelledby="sources" class="space-y-8">
			<h2 id="sources" class="text-xl font-semibold">Sources</h2>
			{
				releases.map((release) => {
					const inRelease = sources.filter((s) => s.release === release.id);
					return (
						inRelease.length > 0 && (
							<div class="space-y-3">
								<h3 class="flex items-center gap-2 font-medium">
									{release.note}
									<Badge variant={release.label === 'Used now' ? 'default' : 'secondary'}>{release.label}</Badge>
								</h3>
								<ul class="grid gap-4 sm:grid-cols-2">
									{inRelease.map((source) => (
										<li>
											<SourceCard source={source} termCount={usage.get(source.id) ?? 0} />
										</li>
									))}
								</ul>
							</div>
						)
					);
				})
			}
		</section>

		<section aria-labelledby="stack" class="space-y-4">
			<h2 id="stack" class="text-xl font-semibold">Built with open source</h2>
			<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					STACK.map((item) => (
						<li class="rounded-lg border bg-card/70 p-3 text-sm backdrop-blur-sm">
							<p class="font-medium">{item.name}</p>
							<p class="text-muted-foreground">{item.purpose}</p>
							<p class="mt-1 text-xs text-muted-foreground">{item.licence}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="help" class="flex flex-wrap items-center justify-between gap-4 rounded-xl border bg-card/70 p-6 backdrop-blur-sm">
			<div>
				<h2 id="help" class="text-lg font-semibold">Spotted a mistake or a missing term?</h2>
				<p class="text-sm text-muted-foreground">Anyone can suggest changes. They are reviewed in the open before they are published.</p>
			</div>
			<a href={suggestTermUrl(SITE.repoUrl)} class={cn(buttonVariants())}>Suggest a term</a>
		</section>
	</div>
</BaseLayout>
