---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductBadge from '@/components/ProductBadge.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import SpotlightBackground from '@/components/SpotlightBackground';
import { cn } from '@/lib/utils';
import { LEVELS, LEVEL_LABELS } from '@/lib/content/levels';
import { getGlossary } from '@/lib/glossary/repository';
import { AVAILABLE_PRODUCTS, PRODUCT_LABELS } from '@/lib/glossary/labels';
import { browsePath, mapPath, termPath } from '@/lib/paths';
import { PRODUCTS } from '@/schema/term';
import { SITE } from '@/config/site';

const terms = await getGlossary();
const starters = terms.filter((t) => !t.legacy).slice(0, 6);

const levelBlurbs = {
	beginner: 'One plain sentence and an everyday analogy. No jargon.',
	maker: 'When to use it, its limits and how it fits with other tools.',
	architect: 'APIs, security model, licensing implications and gotchas.',
} as const;
const roadmap = PRODUCTS.filter((p) => p !== 'cross-platform');
---

<BaseLayout>
	<SpotlightBackground client:load>
		<div class="space-y-4">
			<h1 class="bg-gradient-to-b from-neutral-50 to-neutral-400 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-6xl">
				{SITE.name}
			</h1>
			<p class="max-w-2xl text-lg text-neutral-300">
				Every term, written three ways. Find what a SharePoint word means at the depth you need, see what it was called before,
				and follow how it connects to everything else.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href={browsePath()} class={cn(buttonVariants(), 'bg-white text-black hover:bg-white/90')}>Browse A–Z</a>
				<a href={mapPath()} class={cn(buttonVariants({ variant: 'outline' }), 'border-white/30 bg-transparent text-white hover:bg-white/10 hover:text-white')}>
					Explore the map
				</a>
			</div>
			<p class="text-sm text-neutral-400">Press <kbd class="rounded border border-white/30 px-1.5">/</kbd> anywhere to search.</p>
		</div>
	</SpotlightBackground>

	<section aria-labelledby="levels" class="space-y-3 py-6">
		<h2 id="levels" class="text-xl font-semibold">Three levels for every term</h2>
		<div class="grid gap-4 sm:grid-cols-3">
			{
				LEVELS.map((level) => (
					<Card>
						<CardHeader>
							<CardTitle>{LEVEL_LABELS[level]}</CardTitle>
							<CardDescription>{levelBlurbs[level]}</CardDescription>
						</CardHeader>
					</Card>
				))
			}
		</div>
	</section>

	<section aria-labelledby="start" class="space-y-3 py-6">
		<h2 id="start" class="text-xl font-semibold">Start here</h2>
		<ul class="grid gap-4 sm:grid-cols-2">
			{
				starters.map((term) => (
					<li>
						<a href={termPath(term.id)} class="block h-full">
							<Card className="h-full transition-colors hover:bg-accent">
								<CardHeader>
									<CardTitle className="flex items-center gap-2">
										{term.term} <ProductBadge product={term.product} />
									</CardTitle>
									<CardDescription className="line-clamp-2">{term.summary}</CardDescription>
								</CardHeader>
							</Card>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section aria-labelledby="products" class="space-y-3 py-6">
		<h2 id="products" class="text-xl font-semibold">Coverage</h2>
		<ul class="grid gap-4 sm:grid-cols-3">
			{
				roadmap.map((product) => (
					<li>
						<Card>
							<CardHeader>
								<CardTitle>{PRODUCT_LABELS[product]}</CardTitle>
								<CardDescription>
									{AVAILABLE_PRODUCTS.includes(product) ? 'Available now' : product === 'power-platform' ? 'Coming in v1.1' : 'Coming in v1.2'}
								</CardDescription>
							</CardHeader>
							<CardContent />
						</Card>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
