---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AskPanel from '@/components/ask/AskPanel';
---

<BaseLayout title="Ask" description="Ask a question and get a short answer built only from Decoded365 entries, on your own device.">
	<div class="space-y-6">
		<PageHeader
			eyebrow="Ask Decoded365"
			title="Ask in plain English"
			description="Answers are written on your device using only glossary entries, and they cite the entries they used. If the glossary doesn't cover your question, it says so."
		/>
		<AskPanel client:only="react" />
	</div>
</BaseLayout>
