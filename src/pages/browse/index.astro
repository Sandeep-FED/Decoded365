---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BrowseExplorer from '@/components/browse/BrowseExplorer';
import { toBrowseTerm } from '@/lib/glossary/browse-term';
import { getGlossary } from '@/lib/glossary/repository';
import { AVAILABLE_PRODUCTS, PRODUCT_LABELS } from '@/lib/glossary/labels';
import { termPath } from '@/lib/paths';
import { PRODUCTS } from '@/schema/term';

const terms = (await getGlossary()).map((t) => toBrowseTerm(t, termPath(t.id)));
const products = PRODUCTS.filter((p) => p !== 'cross-platform').map((p) => ({
	value: p,
	label: PRODUCT_LABELS[p],
	available: AVAILABLE_PRODUCTS.includes(p),
}));
---

<BaseLayout title="Browse A–Z" description="Every Decoded365 term, A to Z.">
	<div class="space-y-6">
		<PageHeader
			eyebrow="Glossary"
			title="Browse A–Z"
			description="Filter by name, alias or an old name, narrow by product, and jump to a letter. Legacy and Server-only terms are hidden until you ask for them."
		/>
		<BrowseExplorer client:load terms={terms} products={products} />
	</div>
</BaseLayout>
