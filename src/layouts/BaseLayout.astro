---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SpotlightBackground from '@/components/SpotlightBackground';
import BackToTop from '@/components/islands/BackToTop';
import LinkPreviews from '@/components/islands/LinkPreviews';
import { PREF_KEYS } from '@/lib/preferences';
import { SITE } from '@/config/site';
import { feedPath, withBase } from '@/lib/paths';
import { jsonLdText } from '@/lib/seo/structured-data';

interface Props {
	title?: string;
	description?: string;
	/** Path of the link-preview image; defaults to the site-wide card. */
	image?: string;
	/** `article` for a term page, `website` for everything else. */
	type?: 'website' | 'article';
	/** schema.org data for the page, written as JSON-LD. */
	jsonLd?: object[];
	/** Keep the page out of search results (for maintenance pages). */
	noindex?: boolean;
}

const { title, description = SITE.tagline, image = withBase('og/default.png'), type = 'website', jsonLd = [], noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
// Absolute addresses for sharing; Astro.site comes from the SITE_URL the deploy workflow sets.
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
		/>
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="sitemap" type="application/xml" href={withBase('sitemap.xml')} />
		<link rel="alternate" type="application/atom+xml" title={`${SITE.name}: new and updated terms`} href={feedPath()} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
		<!-- Applies remembered preferences before first paint. Without JavaScript nothing is hidden. -->
		<script is:inline define:vars={{ keys: PREF_KEYS }}>
			(function () {
				var d = document.documentElement;
				d.setAttribute('data-js', '');
				d.setAttribute('data-level', 'beginner');
				d.setAttribute('data-legacy', 'hide');
				try {
					var level = localStorage.getItem(keys.level);
					if (level) d.setAttribute('data-level', level);
					if (localStorage.getItem(keys.legacy) === 'show') d.setAttribute('data-legacy', 'show');
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">
			Skip to content
		</a>
		<SpotlightBackground />
		<SiteHeader />
		<main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
			<slot />
		</main>
		<SiteFooter />
		<BackToTop client:idle />
		<LinkPreviews client:idle />
	</body>
</html>
