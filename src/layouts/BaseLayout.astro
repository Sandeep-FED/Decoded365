---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SpotlightBackground from '@/components/SpotlightBackground';
import { PREF_KEYS } from '@/lib/preferences';
import { SITE } from '@/config/site';
import { withBase } from '@/lib/paths';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<title>{pageTitle}</title>
		<!-- Applies remembered preferences before first paint. Without JavaScript nothing is hidden. -->
		<script is:inline define:vars={{ keys: PREF_KEYS }}>
			(function () {
				var d = document.documentElement;
				d.setAttribute('data-js', '');
				d.setAttribute('data-level', 'beginner');
				d.setAttribute('data-legacy', 'hide');
				try {
					var level = localStorage.getItem(keys.level);
					if (level) d.setAttribute('data-level', level);
					if (localStorage.getItem(keys.legacy) === 'show') d.setAttribute('data-legacy', 'show');
					var theme = localStorage.getItem(keys.theme) || 'system';
					var dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
					d.classList.toggle('dark', dark);
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">
			Skip to content
		</a>
		<SpotlightBackground />
		<SiteHeader />
		<main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
